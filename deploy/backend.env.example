# CurrentMusic backend environment (example)
# Copy to /etc/currentmusic/backend.env and chmod 600; never commit real secrets.
CM_PORT=3010
CM_DATA_DIR=/var/lib/currentmusic
CM_DB=/var/lib/currentmusic/cm.db
CM_AVATAR_DIR=/var/lib/currentmusic/avatars
CM_RELEASES_DIR=/var/lib/currentmusic/releases
CM_X_RELEASES_DIR=/var/lib/currentmusic/releases-x
# Optional read-only Contents token for the public CurrentMusicX CI metadata mirror.
# CM_X_RELEASES_GITHUB_TOKEN=
CM_DEFAULT_HOST=music.example.com
# Optional numeric public user ID to pin in the discovery square.
# CM_SQUARE_PINNED_USER_ID=
# Explicit HTTPS origins for self-hosted passkey registration/login. No wildcards.
CM_PASSKEY_ORIGINS=https://music.example.com
# Optional JSON mapping of Android APK signing origins to configured HTTPS hostnames.
# CM_PASSKEY_ANDROID_ORIGINS='{}'

# NetEase API enhanced instance and its cookie file.
CM_NCM_BASE=http://127.0.0.1:3001
# Optional QQ Music API v3.3.6, bound to a numeric loopback address.
# CM_QQ_MUSIC_BASE=http://127.0.0.1:3200
# Optional KuGouMusicApi concept-mode instance and protected service session.
# CM_KUGOU_BASE=http://127.0.0.1:3201
# CM_KUGOU_PLAYBACK=1
# CM_KUGOU_COOKIE_FILE=/etc/currentmusic/kugou-cookie
# Independent personal session store for cloud and song comments. Create it with
# mode 0700 and ownership of the CurrentMusic service account before enabling.
# CM_KUGOU_ACCOUNT_DIR=/etc/currentmusic/kugou-accounts
# Web 时长增量同步可指定 api-enhanced 安装目录，默认使用 CurrentMusic 同级的 ncm-api。
# CM_NCM_NCBL_DIR=/opt/ncm-api
CM_NCM_COOKIE=/etc/currentmusic/ncm-cookie
# Optional single source for /song/url/match; empty uses automatic fallback including
# the current Vkeys QQ API. Set vkeys to use only that adapter, unm for native UNM.
# CM_NCM_MATCH_SOURCE=unm
# Optional public album metadata index, maintained with tools/update-search-catalog.py.
# CM_SEARCH_CATALOG=/srv/currentmusic/data/search-catalog.json

# Optional primary model (z.ai, glm-5.3-flash, max by default).
# CM_AI_ZAI_KEY=
# Original model fallback and existing web search/fetch tools.
# CM_AI_KEY=
# CM_AI_BASE=https://api.deepseek.com/v1
# CM_AI_MODEL=deepseek-flash
# CM_AI_EFFORT=none

# Optional public feedback publishing to bileizhen/CurrentMusicX Issues.
# Set only in protected server environment configuration.
# CM_FEEDBACK_GITHUB_TOKEN=
# Optional private feedback objects. Create the directory with mode 0700 outside
# web roots and backup sources. The origin must serve /app/ and /cm/.
# CM_FEEDBACK_DIAGNOSTICS_DIR=/var/lib/currentmusic-feedback/objects
# CM_FEEDBACK_DIAGNOSTICS_ORIGIN=https://music.example.com
# Optional screenshots and recordings. Create the 0700 media subdirectory first,
# and enable only Host values whose HTTPS proxy supports raw PUT (25 MiB).
# CM_FEEDBACK_MEDIA_HOSTS=music.example.com

# Optional email codes (register / login / email binding / password reset).
# Use a dedicated transactional email account for verification codes.
# CM_SMTP_HOST=smtp.example.com
# CM_SMTP_SECURITY=ssl
# Defaults to 465 with ssl or 587 with starttls.
# CM_SMTP_PORT=
# Optional PEM trust anchor for a private SMTP service.
# CM_SMTP_CA_FILE=
# CM_SMTP_USER=
# CM_SMTP_PASS=
# Set to an address verified by the relay if the login is not the sender.
# CM_SMTP_FROM=
# Personal Outlook.com OAuth2. Set CM_SMTP_USER to the Outlook mailbox address.
# CM_SMTP_OUTLOOK_TOKEN_FILE=/etc/currentmusic/outlook-smtp.json

# Optional SMS webhook.
# CM_SMS_WEBHOOK=
# CM_SMS_TOKEN=
# CM_SMS_SIGN=CurrentMusic

# Optional cast/share directories.
# CM_CAST_CACHE=/var/lib/currentmusic/cast
# CM_SHARE_DIR=/var/lib/currentmusic/share

# Optional LDDC word-by-word lyrics fallback (separate GPL-3.0 service).
# Install with deploy/install-lddc.sh; it writes these into a systemd drop-in.
# CM_LDDC_URL=http://127.0.0.1:3015
# CM_LDDC_TOKEN=
# CM_LDDC_TIMEOUT=7
# CM_LDDC_RETRY_TTL=7200


# External music service protocol. Register the public client with tools/register-music-service-client.py.
# CM_MUSIC_SERVICE_CLIENT_ID=cs_app_currentmusicx_music_service
# Enable only the capabilities the operator is authorized to provide to external clients.
# CM_MUSIC_SERVICE_MEDIA=lyrics,playback,mv,download,cloud
