[Unit]
Description=CurrentMusic registration mail submission and delivery (Exim)
After=network-online.target
Wants=network-online.target

[Service]
User=Debian-exim
Group=Debian-exim
StateDirectory=currentmusic-mail
StateDirectoryMode=0750
RuntimeDirectory=currentmusic-mail
ExecStart=/usr/sbin/exim4 -C /etc/currentmusic-mail/exim.conf -bdf -q1m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
Restart=on-failure

[Install]
WantedBy=multi-user.target
